{
  "name": "donation-plus",
  "version": "1.0.0",
  "description": "Synagogue donation platform — SaaS multi-tenant",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "cd client && npm install && npm run build && cd ../server && npm install && npx prisma generate",
    "start": "cd server && node src/index.js",
    "migrate": "cd server && npx prisma migrate deploy",
    "seed": "cd server && node src/seed.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev"
  }
}
